# Copia este archivo como .env.local (no se sube a git) y llena los valores.
# En Cloudflare Pages van en Settings → Variables and Secrets (se usan al compilar).
# Sin las dos de Supabase el sitio funciona en modo demostración.

# Supabase → Project Settings → API Keys: Project URL y la clave "publishable" (pública por diseño).
# NUNCA pongas aquí la clave secreta (service_role / secret).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile → la "Site key" (opcional, recomendada). La "Secret key" va en Supabase, no aquí.
VITE_TURNSTILE_SITE_KEY=

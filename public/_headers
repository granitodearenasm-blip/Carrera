# Cloudflare Pages: encabezados de seguridad y caché (sustituye al .htaccess de Hostinger).
# Si agregas un servicio externo nuevo (scripts, iframes, APIs), añádelo a la Content-Security-Policy.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://feeds.behold.so; frame-src https://www.google.com https://maps.google.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# Los archivos de assets/ llevan un hash en el nombre: se pueden guardar para siempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/eventos/hanguk-run/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/eventos/hanguk-run/img/*
  Cache-Control: public, max-age=2592000

/index.html
  Cache-Control: no-cache
